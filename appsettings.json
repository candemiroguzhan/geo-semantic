{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "Ollama":  {
                   "BaseUrl":  "http://localhost:11434",
                   "TimeoutSeconds":  120,
                   "EmbeddingDimensions":  1024,
                   "EmbeddingModel":  "qwen3-embedding:0.6b",
                   "BatchSize":  16
               },
    "Qdrant":  {
                   "Host":  "localhost",
                   "CollectionPrefix":  "geosemantic",
                   "HttpPort":  6333,
                   "GrpcPort":  6334
               },
    "Storage":  {
                    "MaxFeatures":  10000,
                    "MaxUploadSizeMb":  50,
                    "DataDirectory":  "AppData"
                },
    "Search":  {
                   "DefaultTopK":  10,
                   "MaxTopK":  50
               },
    "Map":  {
                "DefaultLongitude":  32.8597,
                "StyleUrl":  "https://tiles.openfreemap.org/styles/dark",
                "DefaultLatitude":  39.9334,
                "DefaultZoom":  11
            },
    "Serilog":  {
                    "MinimumLevel":  {
                                         "Default":  "Information",
                                         "Override":  {
                                                          "Microsoft.AspNetCore":  "Warning",
                                                          "System.Net.Http.HttpClient":  "Warning"
                                                      }
                                     }
                }
}
